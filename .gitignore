# ============================================
# Frontend .gitignore (React + Vite)
# ============================================

# ============================================
# Dependencies
# ============================================
node_modules/
package-lock.json

# ============================================
# Environment Variables (CRITICAL - NEVER COMMIT!)
# ============================================
.env
.env.local
.env.development
.env.production
.env.test

# ============================================
# Build Output
# ============================================
dist/
dist-ssr/
build/
*.local

# ============================================
# Logs
# ============================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================
# OS Files
# ============================================
.DS_Store
.DS_Store?
._*
Thumbs.db

# ============================================
# IDE / Editor
# ============================================
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~

# ============================================
# Testing
# ============================================
coverage/
.nyc_output/

# ============================================
# Temporary Files
# ============================================
tmp/
temp/
*.tmp

# ============================================
# Vite
# ============================================
.vite/

# ============================================
# Code Execution (temporary exclusion)
# ==========================================
.env.example.new
ARCHITECTURE_COMPLETE.md
ARCHITECTURE_SEPARATION_PLAN.md
BULLMQ_IMPLEMENTATION_SUMMARY.md
BULLMQ_SETUP_GUIDE.md
DELETED_FILES_SUMMARY.md
IMPLEMENTATION_SUMMARY.md
INTEGRATION_CHECK.md
LOCAL_SETUP_GUIDE.md
LOCAL_TESTING_GUIDE.md
PM2_SETUP_GUIDE.md
QUICK_REFERENCE.md
QUICK_START_GUIDE.md
README_PM2_ARCHITECTURE.md
TROUBLESHOOTING.md
# ============================================
VITE_API_URL=http://localhost:5050
VITE_API_BASE_URL=http://localhost:5050/api

# ============================================
# FIREBASE CONFIGURATION
# ============================================
# Get these values from your Firebase project settings > General > Your apps
VITE_FIREBASE_API_KEY=AIzaSyCfPOsjd-mlyETb3s7JTZiEDKA-28VdDnE
VITE_FIREBASE_AUTH_DOMAIN=assessment-4e295.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=assessment-4e295
